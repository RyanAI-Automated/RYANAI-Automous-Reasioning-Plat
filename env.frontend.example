# Frontend (Vite) variables. Copy to .env.local for local work, or set the same
# names in Vercel > Project Settings > Environment Variables, then REDEPLOY
# (Vite inlines VITE_* values at build time).
#
# Local development (API from `npm run dev:api` listens on 3001):
VITE_API_BASE_URL=http://localhost:3001
#
# Production on Vercel: the HTTPS origin of your hosted API.
# No trailing slash and no /health:
# VITE_API_BASE_URL=https://your-api-host.example.com
VITE_APP_ENV=development

# Backend only (never put secrets in VITE_ variables):
# PORT=3001
# CORS_ORIGINS=https://your-app.vercel.app
