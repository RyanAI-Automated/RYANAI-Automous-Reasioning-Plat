# RyanAI environment template
#
# Copy to .env for local development. Never commit .env or paste live secrets
# into source control. This file contains BOTH public browser settings and
# backend-only values; only VITE_* values may be supplied to a browser build.
#
# Local Docker Compose overrides DATABASE_URL and REDIS_URL to use the
# postgres and redis service names on the private Compose network.
# Production Render DATABASE_URL is configured separately and must use the
# exact Supabase Connect endpoint/pooler details for this project.

# ---------------------------------------------------------------------
# 1. Browser / Vite build values (public; bundled into the browser)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_APP_ENV=development
VITE_SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# 2. API runtime and local database / cache
# ---------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:9090,http://127.0.0.1:9090

# Use generated local-only values. Replace every placeholder before starting.
# Keep DB_PASSWORD identical to the password segment in DATABASE_URL.
DB_PASSWORD=replace_with_a_random_local_postgres_password
DATABASE_URL=postgresql://ryanai:replace_with_a_random_local_postgres_password@127.0.0.1:5432/ryanai_db

REDIS_PASSWORD=replace_with_a_random_local_redis_password
REDIS_URL=redis://:replace_with_a_random_local_redis_password@127.0.0.1:6379

JWT_SECRET=replace_with_at_least_32_random_characters

# Server-side Supabase configuration. Never use the service-role key in VITE_*.
SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hosted API only: set this only after the session-pooler routing change is
# accepted and only to the hostname shown in this project's Supabase Connect
# dialog. Leave unset for local Docker Postgres.
# SUPABASE_DB_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com

# ---------------------------------------------------------------------
# 3. AI providers (server-side credentials; optional until configured)
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
OPENAI_BASE_URL=

NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

QWEN_API_KEY=
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput

LOGIC_API_KEY=
LOGIC_API_ENDPOINT=https://api.openai.com/v1
LOGIC_REASONING_MODEL=gpt-4o-mini

# Optional provider slots used by the dedicated MCP server
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=http://127.0.0.1:8888/v1
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-1017
TORCHTPU_API_KEY=
TORCHTPU_API_ENDPOINT=http://127.0.0.1:8000/v1
TORCHTPU_MODEL=

# ---------------------------------------------------------------------
# 4. MCP HTTP service and API gateway
# ---------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN must be at least 32 characters; placeholder is rejected by
# scripts/activate-apis.mjs preflight.
MCP_AUTH_TOKEN=replace_with_a_random_mcp_token_at_least_32_characters
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp-server
RYANAI_MCP_ENABLED_TOOLS=platform_health,ryanai_stack_manifest,reasoning_route
RYANAI_OPENAI_GATEWAY_TOKEN=replace_with_a_separate_random_gateway_token

# Compose supplies the internal API hostname to the MCP container:
# RYANAI_API_HEALTH_URL=http://api:3000/health
# RYANAI_OPENAI_GATEWAY_URL=http://api:3000/api/internal/openai/chat

# ---------------------------------------------------------------------
# 5. Communications (API service only; all credentials remain server-side)
# ---------------------------------------------------------------------
# Twilio WhatsApp, SMS and voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_WEBHOOK_URL=
TWILIO_SMS_WEBHOOK_URL=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_ACTION_URL=
TWILIO_STATUS_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
RYANAI_TWILIO_VOICE=Polly.Ayanda-Neural

# Outbound SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Inbound email through Resend Receiving
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Private owner identity. Do not put real phone/email values in this template
# or in the frontend bundle.
RYANAI_OWNER_TITLE=Sir G
RYANAI_OWNER_LANGUAGE=ve-ZA
RYANAI_OWNER_PHONE=
RYANAI_OWNER_EMAIL=

# ---------------------------------------------------------------------
# 6. Optional integrations and operational controls
# ---------------------------------------------------------------------
RYANAI_GITHUB_TOKEN=
RYANAI_GITHUB_REPOSITORY=RyanAI-Automated/RYANAI-Automous-Reasioning-Plat
RYANAI_GITHUB_BASE_BRANCH=main

ATTACHMENT_SCANNER_ENABLED=false
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000
ATTACHMENT_SCAN_INTERVAL_MS=5000

JARVIS_SYNC_ENABLED=false
JARVIS_ALLOW_PRODUCTION_SYNC=false
JARVIS_PATCH_INGRESS_ENABLED=false
# JARVIS_BASE_URL=https://your-approved-jarvis-host
# JARVIS_API_TOKEN=store-in-a-secret-manager
# JARVIS_INGRESS_TOKEN=use-a-separate-secret

SCHEDULER_ENABLED=false
ALERTS_ENABLED=false
BACKUP_ON_STARTUP=false

# Optional MCPJungle / Cloudflare profiles only. Keep unset unless enabled.
# MCPJUNGLE_DB_PASSWORD=replace_with_a_random_mcpjungle_database_password
# CLOUDFLARE_TUNNEL_TOKEN=store_in_a_secret_manager
