# =====================================================================
# RyanAI Autonomous Reasoning Platform - Environment Configuration Template
# Copy this file to .env for local development. Docker Compose overrides DATABASE_URL and REDIS_URL for container networking.
# For Vercel/Render static builds, set VITE_API_BASE_URL to your deployed HTTPS API origin.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Frontend (Vite) Variables (Bundled at build time)
# ---------------------------------------------------------------------
# Local development API endpoint (or your production backend origin)
VITE_API_BASE_URL=
VITE_APP_ENV=development

# Supabase public credentials (Safe for browser / client bundles)
VITE_SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------
# 2. Backend API Gateway & Storage Secrets (Server-Side Only)
# ---------------------------------------------------------------------
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:9090,http://127.0.0.1:9090

# PostgreSQL + pgvector Credentials
# Use a URL-safe hex password for the local Compose database.
DB_PASSWORD=replace_with_64_hex_characters
DATABASE_URL=postgresql://ryanai:replace_with_64_hex_characters@127.0.0.1:5432/ryanai_db
# Render production only: set DATABASE_URL in Render to the Supabase Shared Pooler Session URL.
# DATABASE_URL=postgresql://postgres.narsvpwymvlrhurqbthu:<URL_ENCODED_PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Redis Cache Credentials
REDIS_PASSWORD=replace_with_64_hex_characters
REDIS_URL=redis://:replace_with_64_hex_characters@127.0.0.1:6379

# ---------------------------------------------------------------------
# 3. AI Providers & Model Context Protocol (MCP) Server
# ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
OPENAI_BASE_URL=

# NVIDIA Nemotron / Qwen Integrations (Optional)
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

QWEN_API_KEY=
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput

# Jarvis bridge (server-side only; disabled unless explicitly enabled)
# JARVIS_BASE_URL=https://jarvis.example
# JARVIS_API_TOKEN=store-this-in-a-secret-manager
JARVIS_SYNC_ENABLED=false
JARVIS_ALLOW_PRODUCTION_SYNC=false
JARVIS_PATCH_INGRESS_ENABLED=false
# JARVIS_INGRESS_TOKEN=use-a-different-high-entropy-secret-for-inbound-patches
# JARVIS_HEALTH_PATH=/health
# JARVIS_PATCH_PATH=/api/v1/patches
# JARVIS_STACK_PATH=/api/v1/stacks

# MCP Server Security Token (Must be at least 32 characters in production)
MCP_AUTH_TOKEN=replace_with_a_unique_random_token_at_least_32_characters
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp-server
RYANAI_MCP_ENABLED_TOOLS=platform_health,repository_status,ryanai_stack_manifest,reasoning_route

# Separate secret for MCP-to-API requests; never reuse MCP_AUTH_TOKEN or an AI provider key.
RYANAI_OPENAI_GATEWAY_TOKEN=replace_with_a_different_random_token_at_least_32_characters
RYANAI_OPENAI_GATEWAY_URL=http://api:3000/api/internal/openai/chat

# ---------------------------------------------------------------------
# 4. Server-side communications (never VITE_*; keep credentials private)
# ---------------------------------------------------------------------

# Twilio — WhatsApp, SMS and voice. Callback URLs must match Twilio's registered
# public HTTPS URLs exactly, including path and trailing-slash behavior.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_WEBHOOK_URL=
TWILIO_SMS_WEBHOOK_URL=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_VOICE_ACTION_URL=
TWILIO_STATUS_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
RYANAI_TWILIO_VOICE=

# Outbound email via SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Inbound email via Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Deployment-only owner identity; leave destinations blank in templates.
RYANAI_OWNER_TITLE=Sir G
RYANAI_OWNER_LANGUAGE=ve-ZA
RYANAI_OWNER_PHONE=
RYANAI_OWNER_EMAIL=

# Optional startup backup remains disabled unless explicitly enabled.
BACKUP_ON_STARTUP=false
SUPABASE_BACKUP_BUCKET=
RYANAI_BACKUP_STORAGE_BUCKETS=
