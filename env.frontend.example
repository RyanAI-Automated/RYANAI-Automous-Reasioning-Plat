# =====================================================================
# RyanAI Autonomous Reasoning Platform - Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# 1. Frontend (Vite) Variables (Bundled at build time)
# ---------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_APP_ENV=development

# Supabase public credentials
VITE_SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------
# 2. Backend API Gateway & Storage Secrets (Server-Side Only)
# ---------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGINS=http://localhost:1420,http://localhost:9090,https://ryanai-web.onrender.com

# PostgreSQL + pgvector (For Render/Supabase Production, use Supabase connection pooler port 6543 or direct port 5432 with ?sslmode=require)
DB_PASSWORD=secure_postgres_password_here
DATABASE_URL=postgresql://postgres.narsvpwymvlrhurqbthu:your_db_password_here@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Redis Cache Credentials
REDIS_PASSWORD=secure_redis_password_here
REDIS_URL=redis://:secure_redis_password_here@127.0.0.1:6379

# ---------------------------------------------------------------------
# 3. Communications & Notifications (Twilio, SMTP, Resend)
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@ryanai.org
COMMUNICATIONS_ENABLED=true

# ---------------------------------------------------------------------
# 4. AI Providers & Model Context Protocol (MCP) Server
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
OPENAI_BASE_URL=

NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

QWEN_API_KEY=
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput

# MCP Server Security Token (At least 32 characters)
MCP_AUTH_TOKEN=generate_a_secure_token_with_at_least_32_characters_here
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp-server,ryanai-api
