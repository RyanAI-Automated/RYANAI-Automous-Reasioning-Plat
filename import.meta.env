/// <reference types="vite/client" />

export interface ImportMetaEnvCustom {
  VITE_API_BASE_URL?: string;
  VITE_APP_ENV?: string;
  VITE_SUPABASE_URL?: string;
  VITE_SUPABASE_PUBLISHABLE_KEY?: string;
  VITE_SUPABASE_ANON_KEY?: string;
  VITE_PRIMARY_REASONING_MODEL?: string;
  VITE_SECONDARY_REASONING_MODEL?: string;
  VITE_NVIDIA_API_KEY?: string;
  VITE_TOGETHER_API_KEY?: string;
  VITE_LOCAL_MODEL_URL?: string;
  [key: string]: string | undefined;
}

/**
 * Safely resolves environment variables across Vite, standard Node.js process.env, 
 * and optional default fallback values.
 */
export function getEnv(key: string, defaultValue = ''): string {
  const normalizedKey = key.startsWith('VITE_') ? key : `VITE_${key}`;
  const fallbackKey = key.replace(/^VITE_/, '');

  // Check Vite import.meta.env
  if (typeof import.meta !== 'undefined' && (import.meta as { env?: Record<string, unknown> }).env) {
    const env = (import.meta as { env: Record<string, unknown> }).env;
    if (env[normalizedKey] !== undefined) return String(env[normalizedKey]);
    if (env[fallbackKey] !== undefined) return String(env[fallbackKey]);
    if (env[key] !== undefined) return String(env[key]);
  }

  // Check Node.js process.env
  if (typeof process !== 'undefined' && process.env) {
    if (process.env[normalizedKey] !== undefined) return String(process.env[normalizedKey]);
    if (process.env[fallbackKey] !== undefined) return String(process.env[fallbackKey]);
    if (process.env[key] !== undefined) return String(process.env[key]);
  }

  return defaultValue;
}

/**
 * Strongly typed runtime environment config object for quick retrieval.
 */
export const envConfig = {
  apiBaseUrl: getEnv('VITE_API_BASE_URL', 'http://localhost:3000'),
  appEnv: getEnv('VITE_APP_ENV', 'development'),
  supabaseUrl: getEnv('VITE_SUPABASE_URL'),
  supabasePublishableKey: getEnv('VITE_SUPABASE_PUBLISHABLE_KEY'),
  primaryModel: getEnv('VITE_PRIMARY_REASONING_MODEL', 'nvidia/nemotron-3-ultra'),
  secondaryModel: getEnv('VITE_SECONDARY_REASONING_MODEL', 'Qwen/Qwen3-235B-A22B-Instruct-2507'),
  nvidiaApiKey: getEnv('VITE_NVIDIA_API_KEY'),
  togetherApiKey: getEnv('VITE_TOGETHER_API_KEY'),
  localModelUrl: getEnv('VITE_LOCAL_MODEL_URL', 'http://localhost:8080/v1'),
} as const;
