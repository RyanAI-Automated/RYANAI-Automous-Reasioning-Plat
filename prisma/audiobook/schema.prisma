generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/audiobook-prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("AUDIOBOOK_DATABASE_URL")
  directUrl = env("AUDIOBOOK_DATABASE_URL_UNPOOLED")
}

/// Minimal opaque identity anchor for a Supabase Auth subject.
/// No email, password, token, role, or mutable user metadata is copied into Neon.
model SupabaseIdentity {
  id         String             @id @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  projects   AudiobookProject[]
  renderJobs AudiobookRenderJob[]

  @@map("supabase_identities")
}

model AudiobookProject {
  id        String                 @id @default(uuid())
  userId    String                 @map("user_id") @db.Uuid
  user      SupabaseIdentity       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  title     String                 @db.VarChar(120)
  language  String                 @default("en-ZA") @db.VarChar(16)
  chapters  AudiobookChapter[]
  renderJobs AudiobookRenderJob[]
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, updatedAt(sort: Desc)], map: "audiobook_projects_user_updated_idx")
  @@map("audiobook_projects")
}

model AudiobookChapter {
  id                String          @id @default(uuid())
  projectId         String          @map("project_id")
  project           AudiobookProject @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  title             String          @db.VarChar(120)
  content           String          @default("") @db.Text
  position          Int
  narrationSettings Json            @default("{}") @map("narration_settings")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, position], map: "audiobook_chapters_project_position_key")
  @@index([projectId, position], map: "audiobook_chapters_project_position_idx")
  @@map("audiobook_chapters")
}

model AudiobookRenderJob {
  id                String          @id @default(uuid())
  userId            String          @map("user_id") @db.Uuid
  user              SupabaseIdentity @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectId         String          @map("project_id")
  project           AudiobookProject @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status            String          @default("queued") @db.VarChar(24)
  idempotencyKey    String          @map("idempotency_key") @db.VarChar(120)
  request           Json
  progress          Json            @default("{}")
  result            Json?
  error             String?         @db.Text
  attempts          Int             @default(0)
  maxAttempts       Int             @default(3) @map("max_attempts")
  workerId          String?         @map("worker_id") @db.VarChar(120)
  lockedAt          DateTime?       @map("locked_at") @db.Timestamptz(6)
  leaseExpiresAt    DateTime?       @map("lease_expires_at") @db.Timestamptz(6)
  nextAttemptAt     DateTime        @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  cancelRequestedAt DateTime?       @map("cancel_requested_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)

  @@unique([userId, idempotencyKey], map: "audiobook_render_jobs_user_idempotency_key")
  @@index([status, nextAttemptAt, createdAt], map: "audiobook_render_jobs_status_next_attempt_idx")
  @@index([status, leaseExpiresAt], map: "audiobook_render_jobs_status_lease_idx")
  @@index([userId, createdAt(sort: Desc)], map: "audiobook_render_jobs_user_created_idx")
  @@index([projectId, createdAt(sort: Desc)], map: "audiobook_render_jobs_project_created_idx")
  @@map("audiobook_render_jobs")
}
