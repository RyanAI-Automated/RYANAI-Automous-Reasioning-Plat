datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AgentStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
  PAUSED
}

// ==========================================
// CUSTOM RYANAI BACKEND MODELS
// ==========================================

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String?         @map("password_hash")
  name          String?         @map("name")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  sessions      Session[]
  agentSessions AgentSession[]
  memories      MemoryVault[]
  agents        AgentInstance[]
  agentRuns     AgentRun[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  title     String    @default("New Reasoning Session")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Message {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      Role
  content   String   @db.Text
  reasoning String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("session_messages")
}

model AgentSession {
  id          String         @id @default(uuid())
  operator    String         @default("Ntsiyeni Ganyane")
  activeGraph String         @default("ReAct-v2.1") @map("active_graph")
  cudaActive  Boolean        @default(true) @map("cuda_active")
  userId      String?        @map("user_id")
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  messages    AgentMessage[]

  @@index([createdAt])
  @@index([userId])
  @@map("agent_sessions")
}

model AgentMessage {
  id             String       @id @default(uuid())
  sessionId      String       @map("session_id")
  session        AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role           Role         @default(USER)
  content        String       @db.Text
  reasoningSteps String       @db.Text @map("reasoning_steps")
  latencyMs      Int          @default(14) @map("latency_ms")
  timestamp      String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("agent_messages")
}

model AgentInstance {
  id          String      @id @default(uuid())
  name        String
  description String?
  status      AgentStatus @default(IDLE)
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  config      Json?
  lastActive  DateTime    @default(now()) @map("last_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([userId])
  @@map("agent_instances")
}

model MemoryVault {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  category  String   @default("general")
  tags      String[]
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("memory_vault")
}

model SystemTelemetry {
  id          String   @id @default(uuid())
  cpuUsage    Float?   @map("cpu_usage")
  memoryUsage Float?   @map("memory_usage")
  activeNodes Int?     @map("active_nodes")
  status      String   @default("healthy")
  payload     Json?
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@map("system_telemetry")
}

// ==========================================
// SUPABASE INTEGRATED MODELS
// ==========================================

model Profile {
  id        String    @id @db.Uuid
  email     String?
  fullName  String?   @map("full_name")
  avatarUrl String?   @map("avatar_url")
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @map("updated_at")

  @@map("profiles")
}

model Conversation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @default("New Thread")
  model     String           @default("claude-sonnet-4.6")
  createdAt DateTime?        @default(now()) @map("created_at")
  updatedAt DateTime?        @default(now()) @map("updated_at")
  messages  ChatSqlMessage[]

  @@index([userId])
  @@map("conversations")
}

model ChatSqlMessage {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  model          String?
  steps          Json?
  metadata       Json?
  createdAt      DateTime?    @default(now()) @map("created_at")

  @@index([conversationId])
  @@map("messages")
}

model MemoryEntry {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  key       String
  value     String    @db.Text
  category  String    @default("preference")
  createdAt DateTime? @default(now()) @map("created_at")

  @@unique([userId, key])
  @@index([userId])
  @@map("memory_entries")
}

model ScheduledTask {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  prompt          String    @db.Text
  runAt           DateTime  @map("run_at")
  intervalMinutes Int?      @map("interval_minutes")
  status          String    @default("active")
  lastRunAt       DateTime? @map("last_run_at")
  lastResult      String?   @map("last_result") @db.Text
  lastError       String?   @map("last_error") @db.Text
  lockedUntil     DateTime? @map("locked_until")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status, runAt])
  @@index([userId])
  @@map("scheduled_tasks")
}

// An outbound action that the agent asked for. Nothing leaves the server until an
// administrator approves it. status: pending, approved, rejected, executed, failed.
model PendingAction {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tool      String
  args      Json
  summary   String    @db.Text
  status    String    @default("pending")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  decidedAt DateTime? @map("decided_at")
  decidedBy String?   @map("decided_by")
  result    String?   @db.Text

  @@index([status, expiresAt])
  @@index([userId])
  @@map("pending_actions")
}


model AgentRun {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  objective String @db.Text
  executionScope Json @default("{}") @map("execution_scope")
  approvalStatus String @default("approved") @map("approval_status")
  planSnapshot Json? @map("plan_snapshot")
  planHash String? @map("plan_hash")
  baseCommitSha String? @map("base_commit_sha")
  proposedDiffHash String? @map("proposed_diff_hash")
  approvedPlanHash String? @map("approved_plan_hash")
  approvedCommitSha String? @map("approved_commit_sha")
  approvedDiffHash String? @map("approved_diff_hash")
  approvedBy String? @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  steeringNotes String? @db.Text @map("steering_notes")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  status String @default("queued")
  result Json?
  error String? @db.Text
  attempts Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")
  workerId String? @map("worker_id")
  lockedAt DateTime? @map("locked_at")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  handoffs AgentHandoff[]
  evidence AgentRunEvidence[]
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, lockedAt])
  @@index([status, nextAttemptAt])
  @@index([approvalStatus, createdAt], map: "agent_runs_approval_status_created_idx")
  @@map("agent_runs")
}
model AgentRunEvidence {
  id String @id @default(uuid())
  runId String @map("run_id")
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence Int
  eventType String @map("event_type")
  actorId String? @map("actor_id")
  payload Json
  previousHash String? @map("previous_hash")
  hash String @unique
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([runId, sequence], map: "agent_run_evidence_run_sequence_key")
  @@index([runId, sequence], map: "agent_run_evidence_run_sequence_idx")
  @@map("agent_run_evidence")
}
model AgentHandoff {
  id String @id @default(uuid())
  runId String @map("run_id")
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  fromAgent String @map("from_agent")
  toAgent String @map("to_agent")
  status String @default("pending")
  input String @db.Text
  output String? @db.Text
  error String? @db.Text
  startedAt DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  @@index([runId, startedAt])
  @@map("agent_handoffs")
}
model AgentBrainHealth {
  id String @id @default(uuid())
  brain String @unique
  model String
  status String
  latencyMs Int? @map("latency_ms")
  lastSuccessAt DateTime? @map("last_success_at")
  lastError String? @db.Text @map("last_error")
  checkedAt DateTime @default(now()) @map("checked_at")
  @@map("agent_brain_health")
}


// Curated platform-wide knowledge supplied to every reasoning brain.
model BrainKnowledge {
  id          String   @id @default(uuid())
  fingerprint String   @unique
  title       String
  content     String   @db.Text
  source      String?
  category    String   @default("general")
  tags        String[]
  confidence  Float    @default(0.5)
  priority    Int      @default(0)
  active      Boolean  @default(true)
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([active, priority, updatedAt])
  @@index([expiresAt])
  @@map("brain_knowledge")
}


model CommunicationConversation {
  id              String                   @id @default(uuid())
  channel         String
  externalAddress String                   @map("external_address")
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime                 @default(now()) @updatedAt @db.Timestamptz(6) @map("updated_at")
  messages        CommunicationMessage[]

  @@unique([channel, externalAddress], map: "communication_conversations_channel_address_key")
  @@index([channel, updatedAt], map: "communication_conversations_channel_updated_idx")
  @@map("communication_conversations")
}

model CommunicationMessage {
  id                String                    @id @default(uuid())
  conversationId    String                    @map("conversation_id")
  conversation      CommunicationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         String
  body              String                    @db.Text
  providerMessageId String?                   @unique @map("provider_message_id")
  status            String                    @default("received")
  metadata          Json?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([conversationId, createdAt], map: "communication_messages_conversation_created_idx")
  @@index([status, createdAt], map: "communication_messages_status_created_idx")
  @@map("communication_messages")
}

// LangGraph's PostgresSaver owns these tables and their versioned DDL. They are
// represented here so Prisma's schema-drift check includes the full public
// schema without attempting to create or mutate them from application code.
model LangGraphCheckpointMigration {
  v Int @id

  @@map("checkpoint_migrations")
}

model LangGraphCheckpoint {
  threadId String @map("thread_id")
  checkpointNs String @default("") @map("checkpoint_ns")
  checkpointId String @map("checkpoint_id")
  parentCheckpointId String? @map("parent_checkpoint_id")
  type String?
  checkpoint Json
  metadata Json @default("{}")

  @@id([threadId, checkpointNs, checkpointId])
  @@map("checkpoints")
}

model LangGraphCheckpointBlob {
  threadId String @map("thread_id")
  checkpointNs String @default("") @map("checkpoint_ns")
  channel String
  version String
  type String
  blob Bytes?

  @@id([threadId, checkpointNs, channel, version])
  @@map("checkpoint_blobs")
}

model LangGraphCheckpointWrite {
  threadId String @map("thread_id")
  checkpointNs String @default("") @map("checkpoint_ns")
  checkpointId String @map("checkpoint_id")
  taskId String @map("task_id")
  idx Int
  channel String
  type String?
  blob Bytes
  taskPath String @default("") @map("task_path")

  @@id([threadId, checkpointNs, checkpointId, taskId, idx])
  @@map("checkpoint_writes")
}

model JarvisAuditEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String   @map("actor_id")
  eventType  String   @map("event_type")
  resourceId String?  @map("resource_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)], map: "jarvis_audit_events_actor_created_idx")
  @@map("jarvis_audit_events")
}

/// Legacy vector-backed cache. The pgvector column is accessed through raw SQL;
/// Prisma intentionally treats the extension type as unsupported.
model ReasoningCache {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prompt    String    @db.Text
  response  String    @db.Text
  embedding Unsupported("vector(1536)")?
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  // The HNSW index is intentionally managed by custom SQL. Prisma ORM 6
  // cannot represent pgvector's HNSW access method and cosine operator class.
  @@map("reasoning_cache")
}

/// Session-scoped memory retained from the original vector bootstrap.
model AgentMemory {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.VarChar(255)
  role      String    @db.VarChar(50)
  content   String    @db.Text
  timestamp DateTime? @default(now()) @db.Timestamptz(6)

  @@index([sessionId, timestamp], map: "idx_agent_session")
  @@map("agent_memory")
}
