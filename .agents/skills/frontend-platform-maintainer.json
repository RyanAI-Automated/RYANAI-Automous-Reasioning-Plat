{
  "id": "frontend-platform-maintainer",
  "name": "RyanAI Frontend Platform Maintainer",
  "version": "1.0.0",
  "description": "Audits and maintains the complete RyanAI frontend boundary, including UI code, API endpoints, WebSocket routes, authentication, database health, builds, and patches.",
  "scope": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.css",
    "vite.config.ts",
    "index.html",
    "app/routes.json",
    "Dockerfile.web",
    "nginx.conf.template"
  ],
  "responsibilities": [
    "detect frontend TypeScript and build failures",
    "audit browser API and WebSocket endpoints",
    "verify authenticated request boundaries",
    "check backend and database health contracts",
    "apply deterministic safe patches",
    "validate production frontend builds",
    "report changes without committing secrets"
  ],
  "commands": {
    "audit": "node scripts/frontend-platform-agent.mjs --audit",
    "fix": "node scripts/frontend-platform-agent.mjs --fix",
    "validate": "npm run frontend:validate"
  },
  "policies": {
    "neverCommitSecrets": true,
    "neverRunDatabaseDestructiveCommands": true,
    "neverModifyBackendDataFromBrowser": true,
    "requireAuthenticatedApiBoundary": true,
    "requireHealthEndpoint": true,
    "validateAfterEveryPatch": true,
    "preserveExistingRoutes": true
  }
}
