# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev --legacy-peer-deps \
    && npm cache clean --force

# Copy frontend config and inputs, preventing local .env files from entering the build.
COPY tsconfig*.json ./
COPY vite.config.ts postcss.config.js tailwind.config.js index.html ./
COPY src ./src
COPY app/routes.json ./app/routes.json
COPY models/catalog.json ./models/catalog.json

# Declare public browser settings embedded by Vite at build time.
ARG VITE_SUPABASE_URL=""
ARG VITE_SUPABASE_PUBLISHABLE_KEY=""
ARG VITE_SUPABASE_ANON_KEY=""

# Map ARGs to ENV so Vite can read them via process.env during bundling
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

RUN npm run build

# ==========================================
# Runner Stage (Nginx)
# ==========================================
FROM nginx:alpine AS runner

# Apply available Alpine security upgrades before packaging the web runtime.
RUN apk upgrade --no-cache

ENV PORT=80 \
    API_HOST=api \
    API_PORT=3000

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/conf.d/default.conf.template
COPY docker-entrypoint.sh /usr/local/bin/ryanai-web-entrypoint.sh

# Normalize line endings (handles Windows checkouts) and set execute permissions.
RUN sed -i 's/\r$//' /usr/local/bin/ryanai-web-entrypoint.sh \
    && chmod +x /usr/local/bin/ryanai-web-entrypoint.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["/usr/local/bin/ryanai-web-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
