# RyanAI environment template.
# Copy to .env (never commit .env) and replace every "replace_with_..." value.
# Placeholders only: real keys belong in .env, Vercel/Render settings, or CI secrets.

# ==========================================
# 1. Core server
# ==========================================
NODE_ENV=development
HOST=0.0.0.0
# Local API and Vite proxy use 3001; Docker Compose supplies PORT=3000 to its API.
PORT=3001
LOG_LEVEL=info

# ==========================================
# 2. PostgreSQL and Redis (local development)
# ==========================================
# Docker Compose uses DB_PASSWORD/REDIS_PASSWORD for the containers and builds
# its own service-to-service URLs. The URLs below are for running the API on
# the host against those containers, so their passwords MUST match.
# Use letters and digits only so the URLs need no escaping.
DB_PASSWORD=replace_with_local_db_password
REDIS_PASSWORD=replace_with_local_redis_password
DATABASE_URL=postgresql://ryanai:replace_with_local_db_password@localhost:5432/ryanai_db
REDIS_URL=redis://:replace_with_local_redis_password@localhost:6379
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=2000
REDIS_TIMEOUT=5000

# ==========================================
# 3. Security and authentication
# ==========================================
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars
JWT_EXPIRES_IN=24h
MCP_AUTH_TOKEN=replace_with_a_random_token_at_least_32_characters

# ==========================================
# 4. Health and integration checks
# ==========================================
# Integration checks target Compose; use port 3001 when checking the local API.
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# ==========================================
# 5. AI model providers (server-side only)
# ==========================================
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
# Leave empty for api.openai.com; set to e.g. http://localhost:11434/v1 for Ollama.
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
CUDA_DEVICE_ID=0

# Primary reasoning brain (NVIDIA Nemotron)
PRIMARY_REASONING_MODEL=nvidia/nemotron-3-ultra
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_KEY=

# Secondary large-context brain (Qwen via Together AI)
SECONDARY_REASONING_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_API_KEY=

# Fast logic and tool-use brain (OpenAI or LM Studio)
LOGIC_REASONING_MODEL=gpt-4o-mini
LM_STUDIO_URL=http://localhost:1234/v1

# ==========================================
# 6. Supabase authentication
# ==========================================
# Frontend and API must use the same Supabase project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Server-side only; never expose through a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ==========================================
# 7. Frontend (Vite, exposed to the browser)
# ==========================================
VITE_APP_ENV=development
# Dev-server proxy target for /api and /ws.
VITE_API_URL=http://127.0.0.1:3001
# Browser API origin. Leave empty locally (same-origin via the Vite proxy).
# REQUIRED for Vercel builds: the HTTPS origin of the separately hosted API,
# with no path, e.g. https://api.example.com (the build fails otherwise).
VITE_API_BASE_URL=
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser key fallback; never use a service-role or secret key here.
VITE_SUPABASE_ANON_KEY=

# ==========================================
# 8. Telemetry, MCP and runtime integrations
# ==========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
DEFAULT_CONTAINER=ryanai-runtime
NGROK_AUTHTOKEN=
MCP_ENABLED=true
MCP_PORT=8765
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SENTRY_ENABLED=false
SENTRY_DSN=
TAURI_ENABLED=false

# ==========================================
# 9. Notifications and pipeline integrations (optional)
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Exact public callback URL configured in Twilio, for signature validation.
TWILIO_WHATSAPP_WEBHOOK_URL=
DEFAULT_RECIPIENT_PHONE=
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=
DEFAULT_RECIPIENT_EMAIL=

# ==========================================
# 10. Operator identity and GitHub shipper
# ==========================================
MASTER_OPERATOR="Ntsiyeni Ganyane (Sir G)"
GITHUB_OWNER=rmnganyane
# Fine-grained personal access token used by the GitHub shipper.
GITHUB_PAT=
