# RyanAI local development / Docker Compose environment template.
# Copy to .env and replace every placeholder. Never commit .env or real secrets.
# Use hex-only passwords for DB_PASSWORD and REDIS_PASSWORD because Compose
# inserts them into connection URLs; URI-reserved characters need encoding.

DB_PASSWORD=replace_with_64_hex_characters
REDIS_PASSWORD=replace_with_64_hex_characters
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
MCP_AUTH_TOKEN=replace_with_a_different_random_token_at_least_32_characters

# Blank uses same-origin API requests (Nginx proxy in Compose, Vite proxy in dev).
# Set to your separate HTTPS API origin for a static frontend deployment.
VITE_API_BASE_URL=
VITE_APP_ENV=development
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Local development connection strings. Compose overrides these inside the API container.
DATABASE_URL=postgresql://ryanai:replace_with_64_hex_characters@127.0.0.1:5432/ryanai_db
REDIS_URL=redis://:replace_with_64_hex_characters@127.0.0.1:6379
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:9090,http://127.0.0.1:9090

# Optional server-side AI provider credentials. Never use VITE_* prefixes for these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra
QWEN_API_KEY=
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# Independent logic/synthesis brain (OpenAI-compatible endpoint)
LOGIC_API_KEY=
LOGIC_API_ENDPOINT=https://api.openai.com/v1
LOGIC_REASONING_MODEL=gpt-4o-mini
TOGETHER_API_KEY=
TOGETHER_API_ENDPOINT=https://api.together.xyz/v1
OPENROUTER_API_KEY=
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1

# Optional server-side Supabase settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional MCP HTTP service
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Optional Jarvis integration; disabled unless deliberately enabled
JARVIS_BASE_URL=
JARVIS_API_TOKEN=
JARVIS_SYNC_ENABLED=false
JARVIS_ALLOW_PRODUCTION_SYNC=false
JARVIS_PATCH_INGRESS_ENABLED=false
JARVIS_INGRESS_TOKEN=
JARVIS_HEALTH_PATH=/health
JARVIS_PATCH_PATH=/api/v1/patches
JARVIS_STACK_PATH=/api/v1/stacks

# Required for isolated self-patch verification; use an immutable image digest.
RYAN_PATCH_VERIFIER_IMAGE=
