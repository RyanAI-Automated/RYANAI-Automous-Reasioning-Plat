# ==============================================================================
# RyanAI & GenX Firewall - Unified Local Environment Configuration (.env.local)
# Master Operator: Ntsiyeni Ganyane (Sir G)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Runtime Settings
# ------------------------------------------------------------------------------
# Local API and Vite proxy use 3001; Compose supplies PORT=3000 to its API.
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
API_BASE_URL=http://localhost:3000
API_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 2. Database & Redis Storage Secrets
# ------------------------------------------------------------------------------
DB_PASSWORD=replace_with_a_unique_alphanumeric_password
REDIS_PASSWORD=replace_with_a_different_alphanumeric_password
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars

DATABASE_URL=postgresql://ryanai:replace_with_a_unique_alphanumeric_password@localhost:5432/ryanai_db
REDIS_URL=redis://:replace_with_a_different_alphanumeric_password@localhost:6379
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=2000
REDIS_TIMEOUT=5000
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 3. Model Providers & Sovereign Reasoning Brains
# ------------------------------------------------------------------------------
LLM_PROVIDER=openai
CUDA_DEVICE_ID=0

# Sovereign Identity & Zero-Trust Access Control
MASTER_OPERATOR="Ntsiyeni Ganyane (Sir G)"
AGENT_PA_INTERVAL_MS=10000
GENX_FIREWALL_STRICT=true

# Primary Reasoning Brain (Nvidia Nemotron / Local Runtime)
PRIMARY_REASONING_MODEL=nvidia/nemotron-3-ultra
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_KEY=

# Secondary Massive Context Brain (Qwen / Together AI)
SECONDARY_REASONING_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_API_KEY=
TOGETHER_API_KEY=

# High-Speed Logic & Tool-Use Brain (OpenAI / LM Studio)
LOGIC_REASONING_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
LM_STUDIO_URL=http://localhost:1234/v1

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 4. Authentication & Supabase
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
JWT_SECRET=your-jwt-secret

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

VITE_APP_ENV=production
VITE_API_URL=
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser key fallback; never use a service-role or secret key here.
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 5. Infrastructure, Telemetry & MCP
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
DEFAULT_CONTAINER=ryanai-runtime
NGROK_AUTHTOKEN=

MCP_ENABLED=true
MCP_PORT=8765
MCP_AUTH_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

SENTRY_ENABLED=false
SENTRY_DSN=
TAURI_ENABLED=false

# ------------------------------------------------------------------------------
# 6. Optional Server-Side Pipeline Notifications
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Exact public callback URL configured in Twilio, for signature validation.
TWILIO_WHATSAPP_WEBHOOK_URL=
DEFAULT_RECIPIENT_PHONE=

RESEND_API_KEY=
DISPATCH_FROM_EMAIL=
DEFAULT_RECIPIENT_EMAIL=

# ------------------------------------------------------------------------------
# 7. GitHub Shipper & Pipeline Configuration
# ------------------------------------------------------------------------------
GITHUB_OWNER=NtsiyeniGanyane
GITHUB_TOKEN=
