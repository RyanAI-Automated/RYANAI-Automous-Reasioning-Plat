# ============================================================
# RyanAI — Local Development / Docker Compose Environment
# Copy this file to .env and replace the required placeholders.
# NEVER commit .env or real secrets.
#
# Use hex-only passwords for DB_PASSWORD and REDIS_PASSWORD
# because Compose inserts them into connection URLs.
# ============================================================

# Core security secrets — generate unique random values
DB_PASSWORD=replace_with_64_hex_characters
REDIS_PASSWORD=replace_with_64_hex_characters
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
MCP_AUTH_TOKEN=replace_with_a_different_random_token_at_least_32_characters

# ============================================================
# Frontend
# ============================================================

# Blank uses same-origin API requests (Nginx proxy in Compose,
# Vite proxy in development). Set HTTPS API origin for separate hosting.
VITE_API_BASE_URL=
VITE_APP_ENV=development

# Public/publishable Supabase frontend configuration only.
# The project URL is public; the publishable key is required for Data API access.
VITE_SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Supabase Auth CAPTCHA public frontend configuration. The provider must match
# Supabase Auth > Bot and Abuse Protection. Never put the provider secret in VITE_*.
# Choose turnstile or hcaptcha and provide its public site key.
VITE_SUPABASE_CAPTCHA_PROVIDER=
VITE_SUPABASE_CAPTCHA_SITE_KEY=

# ============================================================
# API / DATABASE / REDIS
# ============================================================

# Local development connection strings.
# Compose overrides these inside the API container.
DATABASE_URL=postgresql://ryanai:replace_with_64_hex_characters@127.0.0.1:5432/ryanai_db
REDIS_URL=redis://:replace_with_64_hex_characters@127.0.0.1:6379

HOST=127.0.0.1
PORT=3001
NODE_ENV=development

CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:9090,http://127.0.0.1:9090

# ============================================================
# AI PROVIDERS — SERVER-SIDE CREDENTIALS ONLY
# Never use VITE_* prefixes for private provider keys.
# ============================================================

# NVIDIA — Primary reasoning brain
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Qwen — Secondary reasoning brain
QWEN_API_KEY=
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-tput

# DeepSeek — Optional OpenAI-compatible local model server (e.g. DGX Spark cluster)
# Loopback is the safe default. Remote endpoints require DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=http://127.0.0.1:8888/v1
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-1017

# TorchTPU — optional OpenAI-compatible serving endpoint backed by vLLM/SGLang + TorchTPU
# TorchTPU is a PyTorch device backend, not an HTTP server; deploy a serving runtime separately.
TORCHTPU_API_KEY=
TORCHTPU_API_ENDPOINT=http://127.0.0.1:8000/v1
TORCHTPU_MODEL=
# Comma-separated MCP action tools to enable. The Compose default enables health, repository, manifest and reasoning only.
# Add run_project_checks explicitly when Jarvis is authorized to execute the fixed validation suite.
RYANAI_MCP_ENABLED_TOOLS=platform_health,repository_status,ryanai_stack_manifest,reasoning_route

# Optional MCPJungle enterprise gateway profile (docker compose --profile mcp-gateway up -d)
# Generate a URL-safe password, e.g. openssl rand -hex 32. Never reuse DB_PASSWORD.
MCPJUNGLE_DB_PASSWORD=
MCPJUNGLE_IMAGE_TAG=0.4.6
MCPJUNGLE_HOST_PORT=8080

# ============================================================
# CLOUDFLARE EDGE — OPTIONAL, CLOUD-FIRST MCP GATEWAY
# Configure the Tunnel and Access policy in Cloudflare first.
# Keep all tokens in the private deployment secret manager.
# ============================================================

# Versioned development default. Before shared/cloud activation, override with a reviewed immutable image digest.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0
# Tunnel token from the named Cloudflare Tunnel. Inject via private runtime environment only.
# Docker Compose mounts it as /run/secrets/cloudflare_tunnel_token for cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=
# Intended hostname; requires the domain to be registered and added to Cloudflare.
CLOUDFLARE_MCP_HOSTNAME=mcp.ryanai.dev

# OpenAI — One server-side credential shared by RyanAI API, agents, MCP gateway and Comms.
# Keep only in the API runtime secret manager; never use a VITE_ prefix or inject into MCP.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Separate private MCP-to-API service credential (not the OpenAI provider key).
RYANAI_OPENAI_GATEWAY_TOKEN=replace_with_a_different_random_token_at_least_32_characters
RYANAI_OPENAI_GATEWAY_URL=http://api:3000/api/internal/openai/chat

# Logic — Independent reasoning and synthesis brain
# Supports OPENAI_API_KEY fallback where implemented.
LOGIC_API_KEY=
LOGIC_API_ENDPOINT=https://api.openai.com/v1
LOGIC_REASONING_MODEL=gpt-4o-mini

# Additional optional providers
TOGETHER_API_KEY=
TOGETHER_API_ENDPOINT=https://api.together.xyz/v1

OPENROUTER_API_KEY=
OPENROUTER_API_ENDPOINT=https://openrouter.ai/api/v1

# ============================================================
# SUPABASE — OPTIONAL SERVER-SIDE CONFIGURATION
# The API uses the same project URL; keep all privileged keys server-only.
# ============================================================

SUPABASE_URL=https://narsvpwymvlrhurqbthu.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IMPORTANT:
# Never expose SUPABASE_SERVICE_ROLE_KEY to frontend/browser code.

# ============================================================
# MCP HTTP SERVICE
# ============================================================

MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ============================================================
# JARVIS INTEGRATION — DISABLED BY DEFAULT
# ============================================================

JARVIS_BASE_URL=
JARVIS_API_TOKEN=

JARVIS_SYNC_ENABLED=false
JARVIS_ALLOW_PRODUCTION_SYNC=false
JARVIS_PATCH_INGRESS_ENABLED=false
JARVIS_INGRESS_TOKEN=

JARVIS_HEALTH_PATH=/health
JARVIS_PATCH_PATH=/api/v1/patches
JARVIS_STACK_PATH=/api/v1/stacks

# ============================================================
# GITHUB SELF-PATCHING
# Fine-grained repository-scoped token only.
# Contents: Read/Write and Pull requests: Read/Write.
# Never use a broad personal access token.
# ============================================================

RYANAI_GITHUB_TOKEN=
RYANAI_GITHUB_REPOSITORY=RyanAI-Automated/RYANAI-Automous-Reasioning-Plat
RYANAI_GITHUB_BASE_BRANCH=main

# ============================================================
# OPTIONAL LOCAL PATCH VERIFIER
# Use an immutable image digest.
# ============================================================

RYAN_PATCH_VERIFIER_IMAGE=
