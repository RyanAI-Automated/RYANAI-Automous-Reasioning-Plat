FROM node:24-alpine
ENV NODE_ENV=production BRIDGE_HOST=0.0.0.0 BRIDGE_PORT=8787
WORKDIR /app
RUN apk upgrade --no-cache
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --legacy-peer-deps && npm cache clean --force
COPY bridge-runtime ./bridge-runtime
USER node
EXPOSE 8787
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/health/ready',{signal:AbortSignal.timeout(3000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "bridge-runtime/server.mjs"]
