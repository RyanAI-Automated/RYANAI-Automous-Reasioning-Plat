{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist/server",
    "rootDir": "./src",
    "skipLibCheck": true,
    "composite": false,
    "noEmit": false,
    "types": ["node"],
    "lib": ["ES2022", "ES2023"],
    "strict": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/server/*": ["./src/server/*"],
      "@/mcp/*": ["./src/mcp/*"],
      "@/db/*": ["./src/db/*"],
      "@/agent/*": ["./src/agent/*"],
      "@/api/*": ["./src/api/*"],
      "@/routes/*": ["./src/routes/*"],
      "@/services/*": ["./src/services/*"],
      "@/types/*": ["./src/types/*"],
      "@/config/*": ["./src/config/*"],
      "@/utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/server/launcher.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "target",
    "scripts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.tsx",
    "src/**/*.test.tsx",
    "src/screens/**/*",
    "src/pages/**/*",
    "src/components/**/*"
  ]
}