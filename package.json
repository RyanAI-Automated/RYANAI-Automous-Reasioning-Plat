{
  "name": "ryan-app",
  "private": true,
  "gypfile": false,
  "version": "0.1.0",
  "description": "RyanAI Autonomous Reasoning Platform",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "### ═══════════════════════════════════════════════════════════ BUILD & VALIDATION ═══════════════════════════════════════════════════════════ ###": "",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "start": "node dist/server/server/launcher.js",
    "start:dev": "tsx src/server/launcher.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "tsc -p tsconfig.app.json && vite build",
    "build:web": "npm run build:client",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run test:cs-script && npm run test:workflows && npm run workflows:check && npm run build && npm run build:server",
    "build:desktop": "tauri build",
    "docker:up": "docker compose up --build --detach --wait",
    "docker:health": "docker compose exec -T api wget -q -O - http://127.0.0.1:3000/health",
    "build:client": "tsc -p tsconfig.app.json && vite build",
    "build:api": "npm run build:server",
    "install:all": "npm ci --legacy-peer-deps && npm --prefix mcp-server ci && npm --prefix workflows-ryanai ci",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host",
    "### ═══════════════════════════════════════════════════════════ DEVELOPMENT ═══════════════════════════════════════════════════════════ ###": "",
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "cross-env NODE_ENV=development tsx watch src/server/launcher.ts",
    "dev:server": "tsx watch src/server/launcher.ts",
    "dev:client": "vite",
    "dev:web": "vite",
    "dev:mcp": "npm --prefix mcp-server run start:http",
    "dev:desktop": "tauri dev",
    "dev:tunnel": "concurrently \"npm run dev:api\" \"npm run tunnel\"",
    "### ═══════════════════════════════════════════════════════════ DOCKER & INFRASTRUCTURE ═══════════════════════════════════════════════════════════ ###": "",
    "docker:build": "docker compose build --no-cache",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "### ═══════════════════════════════════════════════════════════ DATABASE ═══════════════════════════════════════════════════════════ ###": "",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "node --import tsx/esm src/db/migrate.ts",
    "db:setup": "npm run db:generate && npm run db:migrate",
    "### ═══════════════════════════════════════════════════════════ TESTING ═══════════════════════════════════════════════════════════ ###": "",
    "test": "vitest run",
    "test:cs-script": "node --test scripts/check-cs-script.mjs",
    "test:workflows": "python -m unittest discover -s workflows -p test_*.py",
    "workflows:check": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --types node workflows/analyze.ts",
    "test:e2e": "tsx scripts/test-e2e-flow.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:platform": "vitest run test",
    "benchmark:api": "node scripts/benchmark-api.mjs",
    "### ═══════════════════════════════════════════════════════════ SCRIPTING & UTILITIES ═══════════════════════════════════════════════════════════ ###": "",
    "tunnel": "tsx scripts/tunnel.ts",
    "setup:cs-script": "node scripts/setup-cs-script.mjs",
    "orchestrate": "node scripts/orchestrate.mjs",
    "startup:verify": "node scripts/startup-verify.mjs",
    "cmake:configure": "node scripts/cmake.mjs -S native/local-inference -B native/local-inference/build",
    "cmake:build": "node scripts/cmake.mjs --build native/local-inference/build --config Release",
    "build:cuda": "node-gyp rebuild",
    "native:addon:build": "npm run build:cuda",
    "native:configure": "npm run cmake:configure",
    "native:build": "npm run build:cuda && npm run cmake:build",
    "native:local:configure": "node scripts/cmake.mjs -S native/local-inference -B native/local-inference/build",
    "native:local:build": "node scripts/cmake.mjs --build native/local-inference/build --config Release",
    "### ═══════════════════════════════════════════════════════════ PYTHON & RUST ═══════════════════════════════════════════════════════════ ###": "",
    "core:run": "python scripts/ryan_cli.py",
    "core:platform": "python scripts/ryan_cli.py",
    "core:check": "python scripts/check-python-core.py",
    "rust:fetch": "cargo fetch --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml --all-targets",
    "app:check": "npm run typecheck",
    "### ═══════════════════════════════════════════════════════════ MCP & SYSTEM ═══════════════════════════════════════════════════════════ ###": "",
    "mcp:check": "npm --prefix mcp-server run check",
    "mcp:start": "npm --prefix mcp-server start",
    "mcp:http": "npm --prefix mcp-server run start:http",
    "mcp:health": "node scripts/check-mcp-health.mjs",
    "mcp:system": "tsx src/mcp/runSystemServer.ts",
    "telemetry:collect": "node --import tsx/esm --import=./src/telemetry.ts src/mcp/systemServer.ts",
    "### ═══════════════════════════════════════════════════════════ TAURI & RELEASE ═══════════════════════════════════════════════════════════ ###": "",
    "tauri": "tauri",
    "release": "powershell -ExecutionPolicy Bypass -File ./build-installer.ps1",
    "ship": "npm run validate && npm run docker:build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/env": "^7.0.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "@grafana/faro-react": "^2.12.1",
    "@grafana/faro-web-sdk": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@octokit/rest": "^22.0.1",
    "@open-policy-agent/opa-wasm": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@renderinc/sdk": "^1.2.0",
    "@segment/analytics-node": "^3.1.0",
    "@sentry/node": "11.4.0",
    "@sentry/profiling-node": "11.4.0",
    "@supabase/server": "^1.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "docx": "^9.7.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^5.0.0",
    "framer-motion": "^13.2.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^181.0.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.446.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.2.1",
    "resend": "^6.28.1",
    "twilio": "^6.1.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ngrok/ngrok": "^1.7.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bcrypt": "^6.0.0",
    "@types/exceljs": "^0.5.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "node-addon-api": "^8.9.2",
    "node-gyp": "12.4.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.35",
    "prisma": "6.19.3",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "exceljs": {
      "tmp": "^0.2.3",
      "uuid": "^11.0.0"
    },
    "@vitejs/plugin-react": {
      "vite": "$vite"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "concurrently": {
      "shell-quote": "1.12.0"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "puppeteer@25.11.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@sentry/node-cpu-profiler@2.4.4": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
