{
  "name": "ryan-app",
  "private": true,
  "version": "0.1.0",
  "description": "RyanAI Autonomous Reasoning Platform",
  "type": "module",
  "scripts": {
    "### ═══════════════════════════════════════════════════════════ BUILD & VALIDATION ═══════════════════════════════════════════════════════════ ###": "",
    "docker:up": "docker compose up --build -d",
    "docker:health": "docker compose exec ryanai-api curl -s http://localhost:3000/health | jq",
    "build": "tsc -p tsconfig.app.json && vite build",
    "build:client": "tsc -p tsconfig.app.json && vite build",
    "build:server": "tsc",
    "build:api": "tsc",
    "build:desktop": "tauri build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "validate": "npm run typecheck && npm run lint && npm run build",
    "preview": "vite preview --host",
    "### ═══════════════════════════════════════════════════════════ DEVELOPMENT ═══════════════════════════════════════════════════════════ ###": "",
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "cross-env NODE_ENV=development PORT=3001 tsx watch src/server/launcher.ts",
    "dev:server": "tsx watch src/server/launcher.ts",
    "dev:client": "vite",
    "dev:web": "vite",
    "dev:mcp": "node --import tsx/esm src/mcp/systemServer.ts",
    "dev:desktop": "tauri dev",
    "dev:tunnel": "concurrently \"npm run dev:api\" \"npm run tunnel\"",
    "start": "node --import tsx/esm src/server/launcher.ts",
    "start:dev": "node --import tsx/esm src/server/launcher.ts",
    "### ═══════════════════════════════════════════════════════════ DOCKER & INFRASTRUCTURE ═══════════════════════════════════════════════════════════ ###": "",
    "docker:build": "docker compose build --no-cache",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "### ═══════════════════════════════════════════════════════════ DATABASE ═══════════════════════════════════════════════════════════ ###": "",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "node --import tsx/esm src/db/migrate.ts",
    "db:setup": "npm run db:generate && npm run db:migrate",
    "### ═══════════════════════════════════════════════════════════ TESTING ═══════════════════════════════════════════════════════════ ###": "",
    "test": "vitest",
    "test:e2e": "tsx scripts/test-e2e-flow.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:platform": "tsx test-platform.ts",
    "### ═══════════════════════════════════════════════════════════ SCRIPTING & UTILITIES ═══════════════════════════════════════════════════════════ ###": "",
    "tunnel": "tsx scripts/tunnel.ts",
    "orchestrate": "node scripts/orchestrate.mjs",
    "cmake:configure": "node scripts/cmake.mjs -S . -B build",
    "cmake:build": "node scripts/cmake.mjs --build build --config Debug",
    "native:configure": "node scripts/cmake.mjs -S native -B native/build",
    "native:build": "node scripts/cmake.mjs --build native/build --config Release",
    "native:local:configure": "node scripts/cmake.mjs -S native/local-inference -B native/local-inference/build",
    "native:local:build": "node scripts/cmake.mjs --build native/local-inference/build --config Release",
    "### ═══════════════════════════════════════════════════════════ PYTHON & RUST ═══════════════════════════════════════════════════════════ ###": "",
    "core:run": "python ryan-ai-core/main.py",
    "core:platform": "python ryan-ai-core/platform.py",
    "core:check": "python scripts/check-python-core.py",
    "rust:fetch": "cargo fetch --manifest-path src-tauri/Cargo.toml",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:build": "cargo build --manifest-path src-tauri/Cargo.toml --all-targets",
    "app:check": "tsc -p tsconfig.app-core.json --noEmit 2>/dev/null || echo 'tsconfig.app-core.json not found'",
    "### ═══════════════════════════════════════════════════════════ MCP & SYSTEM ═══════════════════════════════════════════════════════════ ###": "",
    "mcp:check": "pnpm --prefix mcp-server run check",
    "mcp:start": "pnpm --prefix mcp-server start",
    "mcp:system": "tsx src/mcp/runSystemServer.ts",
    "telemetry:collect": "node --import tsx/esm --import=./src/telemetry.ts src/mcp/systemServer.ts",
    "### ═══════════════════════════════════════════════════════════ TAURI & RELEASE ═══════════════════════════════════════════════════════════ ###": "",
    "tauri": "tauri",
    "release": "powershell -ExecutionPolicy Bypass -File ./build-installer.ps1",
    "ship": "npm run validate && git add . && git commit -m 'ship: production build' && git push origin main"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/env": "^7.0.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/websocket": "^11.3.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^22.0.1",
    "@open-policy-agent/opa-wasm": "^1.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.12.0",
    "@renderinc/sdk": "^1.2.0",
    "@sentry/node": "^10.75.0",
    "@sentry/profiling-node": "^10.75.0",
    "@supabase/server": "^1.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tauri-apps/api": "^2.11.1",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.4",
    "fastify-plugin": "^6.0.0",
    "fastify-raw-body": "^5.0.0",
    "framer-motion": "^13.2.0",
    "googleapis": "^181.0.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.446.0",
    "node-addon-api": "^8.9.2",
    "nodemailer": "^10.0.10",
    "openai": "^7.23.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.2.1",
    "resend": "^6.28.1",
    "twilio": "^6.1.1",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@ngrok/ngrok": "^1.7.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bcrypt": "^6.0.0",
    "@types/exceljs": "^0.5.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-native": "^0.72.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.18",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.9.0",
    "happy-dom": "^20.14.5",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.4.35",
    "prisma": "^6.12.0",
    "puppeteer": "^25.11.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "exceljs": {
      "tmp": "^0.2.3",
      "uuid": "^11.0.0"
    },
    "@vitejs/plugin-react": {
      "vite": "$vite"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "puppeteer@25.12.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "@sentry/node-cpu-profiler@2.4.4": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
