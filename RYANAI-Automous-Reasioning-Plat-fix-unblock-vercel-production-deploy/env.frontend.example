# =====================================================================
# RyanAI Autonomous Reasoning Platform - Environment Configuration Template
# Copy this file to .env for local development and Docker Compose usage.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Frontend (Vite) Variables (Bundled at build time)
# ---------------------------------------------------------------------
# Local development API endpoint (or your production backend origin)
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# Supabase public credentials (Safe for browser / client bundles)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ---------------------------------------------------------------------
# 2. Backend API Gateway & Storage Secrets (Server-Side Only)
# ---------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGINS=https://app.ryanai.com,http://localhost:9090

# PostgreSQL + pgvector Credentials
DB_PASSWORD=secure_postgres_password_here
DATABASE_URL=postgresql://ryanai:secure_postgres_password_here@postgres:5432/ryanai_db

# Redis Cache Credentials
REDIS_PASSWORD=secure_redis_password_here
REDIS_URL=redis://:secure_redis_password_here@redis:6379

# ---------------------------------------------------------------------
# 3. AI Providers & Model Context Protocol (MCP) Server
# ---------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
OPENAI_BASE_URL=

# NVIDIA Nemotron / Qwen Integrations (Optional)
NVIDIA_API_KEY=
NVIDIA_API_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra

QWEN_API_KEY=
QWEN_API_ENDPOINT=https://api.together.xyz/v1
QWEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# MCP Server Security Token (Must be at least 32 characters in production)
MCP_AUTH_TOKEN=generate_a_secure_token_with_at_least_32_characters_here
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
