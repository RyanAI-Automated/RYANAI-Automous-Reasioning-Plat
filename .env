REDIS_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ryanai?schema=public
REDIS_URL=redis://localhost:6379
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=2000
REDIS_TIMEOUT=5000

