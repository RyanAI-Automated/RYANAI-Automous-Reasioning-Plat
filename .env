# ==========================================
# 1. Core Server Configuration
# ==========================================
NODE_ENV=development
HOST=0.0.0.0
# Local API and Vite proxy use 3001; Docker Compose supplies PORT=3000 to its API.
PORT=3001
LOG_LEVEL=info

# ==========================================
# 2. Database & Caching (PostgreSQL & Redis)
# ==========================================
DB_PASSWORD=postgres
REDIS_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ryanai?schema=public
REDIS_URL=redis://localhost:6379
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=2000
REDIS_TIMEOUT=5000

# ==========================================
# 3. Security & Authentication Tokens
# ==========================================
JWT_SECRET=super-secret-jwt-key-change-me-in-production
JWT_EXPIRES_IN=24h
MCP_AUTH_TOKEN=ryan-mcp-secure-token

# ==========================================
# 4. AI & Model Providers (Server-Side)
# ==========================================
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_ALLOWED_MODELS=gpt-4o,gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
TOGETHER_API_KEY=
NVIDIA_NEMOTRON_KEY=
QWEN_API_KEY=
CUDA_DEVICE_ID=0

# ==========================================
# 5. Supabase Backend Authentication
# ==========================================
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# ==========================================
# 6. Frontend / Vite Application Variables
# ==========================================
VITE_APP_ENV=production
VITE_API_URL=http://127.0.0.1:3001
VITE_API_BASE_URL=http://127.0.0.1:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy browser key fallback; never use a service-role or secret key here.
VITE_SUPABASE_ANON_KEY=

# ==========================================
# 7. Telemetry, MCP & Runtime Integrations
# ==========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
DEFAULT_CONTAINER=ryanai-runtime
NGROK_AUTHTOKEN=
MCP_ENABLED=true
MCP_PORT=8765
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
SENTRY_ENABLED=false
SENTRY_DSN=
TAURI_ENABLED=false

# ==========================================
# 8. Notifications & Pipeline Integrations
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# Exact public callback URL configured in Twilio, for signature validation.
TWILIO_WHATSAPP_WEBHOOK_URL=
DEFAULT_RECIPIENT_PHONE=
RESEND_API_KEY=
DISPATCH_FROM_EMAIL=
DEFAULT_RECIPIENT_EMAIL=

MASTER_OPERATOR="Ntsiyeni Ganyane (Sir G)"

