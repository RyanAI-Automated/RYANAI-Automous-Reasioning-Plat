### 4. Verification & Documentation Workflows (Updated with Daily Schedules)

#### `.github/workflows/copilot-setup-steps.yml`
*Added daily schedule (`0 4 * * *`) for automated workspace validation[cite: 16].*
```yaml
name: Copilot Setup & Verification Steps

on:
  workflow_call:
    inputs:
      node-version:
        required: false
        type: string
        default: '20.x'
      target-path:
        required: false
        type: string
        default: 'features/copilot'
  schedule:
    - cron: '0 4 * * *'
  workflow_dispatch:
  pull_request:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  setup-and-verify:
    name: Setup & Verify Copilot Workspace
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: ${{ inputs.node-version || '20.x' }}
          cache: 'npm'

      - name: Install Dependencies
        run: npm ci

      - name: Type-Check & Lint
        run: |
          npx tsc --noEmit --pretty
          npm run lint

      - name: Run Scoped Copilot Feature Tests
        run: |
          npm test -- "${{ inputs.target-path || 'features/copilot' }}" --passWithNoTests
        env:
          CI: true
          NODE_ENV: test
```[cite: 16]

#### `.github/workflows/docs.yml`
*Added daily schedule (`0 6 * * *`) for continuous OpenAPI/Swagger specification validation[cite: 21].*
```yaml
name: API Specification Validation

on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]
  schedule:
    - cron: '0 6 * * *'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate-docs:
    name: Validate Docs & API Specs
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Validate OpenAPI & Swagger Specs
        run: |
          set -euo pipefail
          mapfile -d '' specs < <(find . -type f \( -name '*.openapi.json' -o -name '*.swagger.json' \) -not -path '*/node_modules/*' -print0)
          mapfile -d '' yaml_specs < <(find . -type f \( -name '*.openapi.yaml' -o -name '*.openapi.yml' -o -name '*.swagger.yaml' -o -name '*.swagger.yml' \) -not -path '*/node_modules/*' -print0)
          if [ "${#specs[@]}" -eq 0 ] && [ "${#yaml_specs[@]}" -eq 0 ]; then
            echo "::notice::No OpenAPI or Swagger specifications found to validate."
            exit 0
          fi
          for spec in "${specs[@]}"; do
            echo "Validating $spec"
            node --input-type=commonjs -e 'JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"))' "$spec"
          done

          if [ "${#yaml_specs[@]}" -gt 0 ]; then
            python -m pip install --disable-pip-version-check PyYAML
            for spec in "${yaml_specs[@]}"; do
              echo "Validating $spec"
              python -c 'import pathlib, sys, yaml; yaml.safe_load(pathlib.Path(sys.argv[1]).read_text())' "$spec"
            done
          fi
```[cite: 21]

