### 2. Security & Infrastructure Configurations

#### `code-security.datadog.yaml`
*Validated Datadog SAST configuration for TypeScript and JavaScript rulesets[cite: 14].*
```yaml
schema-version: v1.0
sast:
  use-default-rulesets: false
  use-rulesets:
    - tsx-react
    - typescript-best-practices
    - typescript-browser-security
    - typescript-code-style
    - typescript-common-security
    - typescript-express
    - typescript-inclusive
    - typescript-node-security
    - javascript-best-practices
    - javascript-browser-security
    - javascript-code-style
    - javascript-common-security
    - javascript-express
    - javascript-inclusive
    - javascript-node-security
    - jsx-react

  global-config:
    ignore-paths:
      - "node_modules/**"
      - "dist/**"
      - "build/**"
      - ".next/**"
      - ".turbo/**"
      - ".vercel/**"
      - "coverage/**"
      - "src-tauri/target/**"
```[cite: 14]

#### `database-infra.yaml`
*Production-grade Kubernetes manifests for PostgreSQL (with pgvector) and Redis persistent volumes, deployments, and services[cite: 17].*
```yaml
# =====================================================================
# RyanAI Autonomous Reasoning Platform - Database & Cache Infrastructure
# Namespace: ryanai-system
# =====================================================================
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-pvc
  namespace: ryanai-system
spec:
  accessModes: [ "ReadWriteOnce" ]
  storageClassName: manual
  resources:
    requests:
      storage: 10Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: ryanai-system
  labels:
    app: postgres
    platform: ryanai
spec:
  replicas: 1
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      containers:
        - name: postgres
          image: pgvector/pgvector:pg16
          env:
            - name: POSTGRES_USER
              value: "ryanai"
            - name: POSTGRES_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ryanai-secrets
                  key: DB_PASSWORD
            - name: POSTGRES_DB
              value: "ryanai_db"
            - name: POSTGRES_INITDB_ARGS
              value: "-c shared_preload_libraries=vector"
          ports:
            - containerPort: 5432
              name: postgres
          livenessProbe:
            exec:
              command: ["pg_isready", "-U", "ryanai", "-d", "ryanai_db"]
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            exec:
              command: ["pg_isready", "-U", "ryanai", "-d", "ryanai_db"]
            initialDelaySeconds: 5
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: ryanai-system
spec:
  ports:
    - port: 5432
      targetPort: 5432
      name: postgres
  selector:
    app: postgres
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: redis-pvc
  namespace: ryanai-system
spec:
  accessModes: [ "ReadWriteOnce" ]
  storageClassName: manual
  resources:
    requests:
      storage: 5Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: ryanai-system
  labels:
    app: redis
    platform: ryanai
spec:
  replicas: 1
  selector:
    matchLabels:
      app: redis
  template:
    metadata:
      labels:
        app: redis
    spec:
      containers:
        - name: redis
          image: redis:7-alpine
          command:
            - "sh"
            - "-c"
            - "exec redis-server --appendonly yes --requirepass \"$REDIS_PASSWORD\""
          env:
            - name: REDIS_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: ryanai-secrets
                  key: REDIS_PASSWORD
          ports:
            - containerPort: 6379
              name: redis
          livenessProbe:
            exec:
              command: ["sh", "-c", "redis-cli -a \"$REDIS_PASSWORD\" ping"]
            initialDelaySeconds: 15
            periodSeconds: 10
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: ryanai-system
spec:
  ports:
    - port: 6379
      targetPort: 6379
      name: redis
  selector:
    app: redis
```[cite: 17]

