### 3. Container & Deployment Workflows (Updated with Daily Schedules)

#### `.github/workflows/container-security.yml`
*Added a daily cron schedule (`0 3 * * *`) for continuous container security vulnerability scanning[cite: 15].*
```yaml
name: Container Security Scan

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
  schedule:
    - cron: '0 3 * * *'
  workflow_dispatch:

permissions:
  contents: read
  security-events: write

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  scan:
    name: Scan ${{ matrix.image }} image
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        include:
          - image: api
            target: api
          - image: web
            target: web
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build image for scanning
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile
          target: ${{ matrix.target }}
          load: true
          tags: ryanai-${{ matrix.image }}:scan

      - name: Scan for high and critical vulnerabilities
        uses: aquasecurity/trivy-action@v0.36.0
        with:
          image-ref: 'docker://ryanai-${{ matrix.image }}:scan'
          format: sarif
          output: trivy-${{ matrix.image }}.sarif
          severity: HIGH,CRITICAL
          ignore-unfixed: true
          exit-code: '1'

      - name: Upload scan results
        if: always()
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: trivy-${{ matrix.image }}.sarif
          category: container-${{ matrix.image }}
```[cite: 15]

#### `.github/workflows/docker-build.yml`
*Added a daily cron schedule (`0 2 * * *`) for continuous image build verification[cite: 19].*
```yaml
name: Validate Docker Images

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]
  schedule:
    - cron: '0 2 * * *'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Build ${{ matrix.image }} image
    runs-on: ubuntu-latest
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        include:
          - image: api
            target: api
          - image: web
            target: web
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      - name: Build image (no publish)
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile
          target: ${{ matrix.target }}
          push: false
          tags: ryanai-${{ matrix.image }}:ci
          cache-from: type=gha
          cache-to: type=gha,mode=max
```[cite: 19]

#### `.github/workflows/docker-publish.yml`
*Updated with a daily schedule (`0 5 * * *`) for automated registry builds and tag maintenance[cite: 20].*
```yaml
name: Publish RyanAI API Image

on:
  schedule:
    - cron: '0 5 * * *'
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  publish:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      - name: Normalize image name
        id: image
        env:
          REPOSITORY: ${{ github.repository }}
        run: echo "name=$(echo "ghcr.io/${REPOSITORY}/api" | tr '[:upper:]' '[:lower:]')" >> "$GITHUB_OUTPUT"
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      - name: Log in to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Extract image metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ steps.image.outputs.name }}
          tags: |
            type=ref,event=branch
            type=sha,format=short
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' || github.ref == 'refs/heads/master' }}
      - name: Build and publish API image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile
          target: api
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
```[cite: 20]

#### `.github/workflows/deploy-vercel.yml`
*Updated with daily scheduled execution (`0 7 * * *`) alongside workflow run triggers[cite: 18].*
```yaml
name: Deploy Vercel Production

on:
  workflow_run:
    workflows: ["CI - Build, Test, and Integrate"]
    branches: [main, master]
    types: [completed]
  schedule:
    - cron: '0 7 * * *'
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: vercel-production
  cancel-in-progress: false

jobs:
  deploy:
    name: Deploy validated commit
    if: >-
      ${{
        vars.VERCEL_DEPLOY_ENABLED == 'true' &&
        (
          github.event_name == 'workflow_dispatch' ||
          github.event_name == 'schedule' ||
          (
            github.event.workflow_run.conclusion == 'success' &&
            github.event.workflow_run.event == 'push' &&
            (github.event.workflow_run.head_branch == 'main' || github.event.workflow_run.head_branch == 'master')
          )
        )
      }}
    uses: ./.github/workflows/deploy.yml
    with:
      commit_sha: ${{ github.event_name == 'workflow_dispatch' || github.event_name == 'schedule' && github.sha || github.event.workflow_run.head_sha }}
    secrets: inherit
```[cite: 18]

